# ==========================================
# APPLICATION CONFIG
# ==========================================
APP_NAME=scanleni-pro
API_PREFIX=/api/v1
SECRET_KEY=LLM_API_KEY=gsk_your_groq_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# OCR CONFIG
# ==========================================
OCR_CONFIDENCE_THRESHOLD=0.45
OCR_MAX_DIM=1500

# ==========================================
# LLM / RAG CONFIG (GROQ)
# ==========================================
# Groq uses OpenAI-compatible API format, so provider stays "openai"
LLM_PROVIDER=openai
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_TOP_K=4

# ==========================================
# DATABASE & CACHE (Local/Docker defaults)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scanleni
REDIS_URL=redis://localhost:6379/0

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60